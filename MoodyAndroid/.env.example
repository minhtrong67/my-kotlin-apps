# Firebase configuration for the Android app (replaces google-services.json).
# Copy this file to ".env" and fill in the values. ".env" is git-ignored. Never commit it, never paste it in chats/issues.
# Values come from Firebase console -> Project settings -> Your apps -> Android app (or from google-services.json).
FIREBASE_PROJECT_ID=
FIREBASE_PROJECT_NUMBER=
FIREBASE_STORAGE_BUCKET=
FIREBASE_APP_ID=
FIREBASE_API_KEY=
# OAuth *web* client id (client_type 3 in google-services.json): needed for "Sign in with Google"
GOOGLE_WEB_CLIENT_ID=
