# Copy to ".env" (git-ignored) and fill in. Real environment variables override this file.

# Base64 of google-services.json from the Firebase console.
#   Windows PowerShell:  [Convert]::ToBase64String([IO.File]::ReadAllBytes("app\google-services.json"))
#   or just run:         powershell -File scripts\make-env.ps1
GOOGLE_SERVICES_JSON_BASE64=

# Release signing (optional) — forward slashes, path relative to the project root.
KEYSTORE_FILE=keystore/expenser-release.jks
KEYSTORE_PASSWORD=
KEY_ALIAS=expenser
KEY_PASSWORD=

# imgbb API key (free: https://api.imgbb.com/) - needed to upload photos from the device.
IMGBB_API_KEY=
